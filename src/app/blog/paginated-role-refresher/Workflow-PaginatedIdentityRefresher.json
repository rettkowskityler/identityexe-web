										"roundingMode": "roundHalfUp",
										"variableB": 250
									}
								}
							],
							"variableA.$": "$.trigger.currentoffset"
						},
						{
							"description": "",
							"name": "identities",
							"transforms": [],
							"variableA.$": "$.hTTPRequest.body[*].id"
						}
					]
				},
				"displayName": "Set Variables",
				"nextStep": "Define Comparison 1",
				"type": "Mutation"
			},
			"Define Variable 1": {
