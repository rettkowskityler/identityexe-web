					}
				],
				"defaultStep": "Define Comparison",
				"displayName": "Check If Identity List Refresh",
				"type": "choice"
			},
			"Define Comparison 2": {
				"actionId": "sp:compare-multi-type",
				"choiceList": [
					{
						"NOT": {
							"comparator": "IsNull",
							"variableA.$": "$.hTTPRequest4.body.membership"
						},
						"nextStep": "Define Variable 1"
					}
				],
				"defaultStep": "Define Comparison",
				"displayName": "Check If Identity List Membership Is Null",
				"type": "choice"
			},
			"Define Comparison 3": {
				"actionId": "sp:compare-multi-type",
				"choiceList": [
					{
						"comparator": "NumericGreaterThan",
