			"Define Comparison 1": {
				"actionId": "sp:compare-multi-type",
				"choiceList": [
					{
						"OR": [
							{
								"AND": [
									{
										"comparator": "StringEquals",
										"variableA.$": "$.interactiveForm.formData.options",
										"variableB": "Back Up And Remove All"
									},
									{
										"comparator": "BooleanEquals",
										"variableA.$": "$.interactiveForm.formData.warningThisWillDisableAllAggregationsAcrossTheTenantProceed",
										"variableB": true
									}
								]
							},
							{
								"AND": [
									{
										"comparator": "StringEquals",
										"variableA.$": "$.interactiveForm.formData.options",
										"variableB": "Restore All"
									},
									{
										"comparator": "BooleanEquals",
										"variableA.$": "$.interactiveForm.formData.WarningThisWillEnableAllAggregationsAcrossTheTenantProceed",
										"variableB": true
									}
								]
							},
							{
								"OR": [
									{
										"comparator": "StringEquals",
										"variableA.$": "$.interactiveForm.formData.options",
										"variableB": "Export"
									},
									{
										"comparator": "StringEquals",
										"variableA.$": "$.interactiveForm.formData.options",
										"variableB": "Import"
									}
								]
							}
						],
