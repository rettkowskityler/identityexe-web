			"Serial Loop": {
				"actionId": "sp:serial:iterator",
				"attributes": {
					"condition": {
						"comparator": "NumericLessThan",
						"variableA.$": "$.defineVariable.counter",
						"variableB.$": "$.windowsServer.result.data.iterations"
					},
					"loopType": "while",
					"start": "Define Comparison",
					"steps": {
						"Define Comparison": {
							"actionId": "sp:compare-multi-type",
							"choiceList": [
								{
									"AND": [
										{
											"comparator": "BooleanEquals",
											"variableA.$": "$.interactiveForm.formData.sendReminderNow",
											"variableB": true
										},
										{
											"comparator": "NumericEquals",
											"variableA.$": "$.defineVariable.counter",
											"variableB": 0
										}
									],
									"nextStep": "Windows Server 1"
								}
							],
							"defaultStep": "Wait",
							"displayName": "Check if Send Reminder Now",
							"type": "choice"
						},
						"End Step - Success 1": {
							"actionId": "sp:operator-success",
							"displayName": "",
							"type": "success"
						},
						"Update Variable": {
