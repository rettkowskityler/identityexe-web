							"attributes": {
								"id": "sp:update-variable",
								"variables": [
									{
										"description": "",
										"name": "$.defineVariable.counter",
										"transforms": [
											{
												"id": "sp:transform:add:number",
												"input": {
													"precision": 4,
													"roundingMode": "roundHalfUp",
													"variableB": 1
												}
											}
										],
										"variableA.$": "$.defineVariable.counter"
									}
								]
							},
							"displayName": "",
							"nextStep": "End Step - Success 1",
							"type": "Mutation"
						},
						"Wait": {
							"actionId": "sp:sleep",
							"attributes": {
								"duration.$": "$.defineVariable.timeconverter",
								"type": "waitFor"
							},
